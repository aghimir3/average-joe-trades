// ============================================================================
// QUANT RESEARCH & GOVERNANCE
// ============================================================================

// QuantModelRegistry - Versioned model metadata for auditability and reproducibility
model QuantModelRegistry {
  id String @id @default(uuid()) @db.UniqueIdentifier

  // Null userId means shared/community model
  userId String? @db.UniqueIdentifier
  scope  String  @db.VarChar(20)  // personal | community

  // Model identity
  modelFamily          String @db.VarChar(100) // wheel, options, stocks, regime, etc.
  modelName            String @db.VarChar(100)
  semanticVersion      String @db.VarChar(30)  // e.g., 1.2.0
  featureSchemaVersion String @db.VarChar(30)  // e.g., stock-v1
  trainingDatasetHash  String @db.VarChar(128) // hash of train dataset snapshot

  // Lifecycle
  status   String  @default("draft") @db.VarChar(20) // draft | stable | archived
  isStable Boolean @default(false) @db.Bit

  // Metrics and metadata snapshots
  metricsSnapshot String? @db.NVarChar(Max) // JSON
  metadata        String? @db.NVarChar(Max) // JSON

  // Timestamps
  trainedAt DateTime? @db.DateTime
  createdAt DateTime  @default(now()) @db.DateTime
  updatedAt DateTime  @updatedAt @db.DateTime

  // Relations
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  evaluations QuantModelEvaluation[]

  @@index([userId])
  @@index([scope, modelFamily, modelName, isStable])
  @@index([scope, modelFamily, modelName, semanticVersion])
  @@map("quantModelRegistry")
}

// QuantModelEvaluation - Walk-forward/OOS/drift evaluation snapshots per model version
model QuantModelEvaluation {
  id String @id @default(uuid()) @db.UniqueIdentifier

  userId          String? @db.UniqueIdentifier
  modelRegistryId String  @db.UniqueIdentifier

  evaluationType String @db.VarChar(40) // walk_forward, oos, calibration, drift
  windowStart    DateTime? @db.DateTime
  windowEnd      DateTime? @db.DateTime

  metrics          String  @db.NVarChar(Max) // JSON
  calibrationScore Decimal? @db.Decimal(10, 6)
  driftScore       Decimal? @db.Decimal(10, 6)

  createdAt DateTime @default(now()) @db.DateTime

  // Relations
  user  User?              @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  model QuantModelRegistry @relation(fields: [modelRegistryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([modelRegistryId, createdAt])
  @@map("quantModelEvaluations")
}

// QuantBacktestRun - Persisted alpha-lab runs for queueing/polling and audit trail
model QuantBacktestRun {
  id String @id @default(uuid()) @db.UniqueIdentifier

  userId String @db.UniqueIdentifier

  // Request payload
  strategyKey String  @db.VarChar(80)
  symbol      String? @db.VarChar(20)
  configJson  String  @db.NVarChar(Max)

  // Result payload
  status      String  @default("pending") @db.VarChar(20) // pending | running | completed | failed
  metricsJson String? @db.NVarChar(Max)
  equityCurve String? @db.NVarChar(Max)
  errorMessage String? @db.NVarChar(1000)

  startedAt   DateTime? @db.DateTime
  completedAt DateTime? @db.DateTime
  createdAt   DateTime  @default(now()) @db.DateTime
  updatedAt   DateTime  @updatedAt @db.DateTime

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("quantBacktestRuns")
}

// ============================================================================
// ML/DL FOR WHEEL STRATEGY
// ============================================================================

// WheelMLModel - Stores trained TensorFlow.js models for wheel strategy predictions
// Each user can have multiple model types (candidate-ranker, strike-optimizer, roll-advisor)
// Models are stored as binary weights + JSON topology for Azure compatibility
model WheelMLModel {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  userId        String   @db.UniqueIdentifier
  modelType     String   @db.VarChar(50) // candidate-ranker, strike-optimizer, roll-advisor

  // Versioning
  version       Int      @default(1) @db.Int

  // Model artifacts - TensorFlow.js format
  modelTopology String   @db.NVarChar(Max) // model.json topology as JSON string
  modelWeights  Bytes                      // Binary weights (varbinary(max) in MSSQL)

  // Training metadata
  accuracy      Decimal? @db.Decimal(5, 4)  // Model accuracy (0.0000-1.0000)
  loss          Decimal? @db.Decimal(10, 6) // Final training loss
  tradesUsed    Int?     @db.Int            // Number of trades used for training
  epochsTrained Int?     @db.Int            // Number of training epochs
  trainingStats String?  @db.NVarChar(Max)  // JSON with detailed training stats

  // Status
  trainedAt     DateTime @default(now()) @db.DateTime
  isActive      Boolean  @default(true) @db.Bit

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Only one active model per type per user
  @@unique([userId, modelType, isActive])
  @@index([userId])
  @@index([userId, modelType])
  @@map("wheelMLModels")
}

// WheelPrediction - Stores model predictions for accuracy tracking
// Used to measure prediction quality and improve models over time
model WheelPrediction {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  userId          String   @db.UniqueIdentifier

  // Prediction details
  predictionType  String   @db.VarChar(30) // ranking, strike_dte, roll
  symbol          String   @db.VarChar(20)
  prediction      String   @db.NVarChar(Max) // JSON serialized prediction output

  // Outcome tracking (filled in later)
  actualOutcome   String?  @db.NVarChar(Max) // JSON of what actually happened
  wasAccurate     Boolean? @db.Bit           // Was the prediction correct?

  // Timestamps
  createdAt       DateTime @default(now()) @db.DateTime
  resolvedAt      DateTime? @db.DateTime     // When outcome was recorded

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, predictionType])
  @@index([symbol])
  @@map("wheelPredictions")
}

// WheelTrainingData - Pre-computed feature snapshots for model training
// Captures features at trade entry and outcomes for supervised learning
model WheelTrainingData {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  userId          String   @db.UniqueIdentifier
  realizedCloseId String?  @db.UniqueIdentifier // Link to the source trade

  // Trade identification
  symbol          String   @db.VarChar(20)
  strategy        String   @db.VarChar(30) // cash_secured_put, covered_call

  // Feature snapshot at time of trade entry
  features        String   @db.NVarChar(Max) // JSON serialized feature vector

  // Outcome labels for training
  totalReturn     Decimal  @db.Decimal(18, 6)
  annualizedReturn Decimal? @db.Decimal(18, 6)
  wasSuccessful   Boolean  @db.Bit           // P&L > 0?
  wasAssigned     Boolean  @db.Bit           // Was option assigned?
  holdDays        Int      @db.Int

  // Trade dates for reference
  tradeDate       DateTime @db.DateTime
  closeDate       DateTime @db.DateTime

  // Timestamps
  createdAt       DateTime @default(now()) @db.DateTime

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, symbol])
  @@index([userId, strategy])
  @@map("wheelTrainingData")
}

// CommunityMLModel - Stores aggregated ML models trained on all users' data
// No foreign key to User - these are system-wide models
model CommunityMLModel {
  id            String   @id @default(uuid()) @db.UniqueIdentifier

  // Model identification
  modelType     String   @db.VarChar(50) // aggregated-ranker, etc.

  // Versioning
  version       Int      @default(1) @db.Int

  // Model artifacts - TensorFlow.js format
  modelTopology String   @db.NVarChar(Max) // model.json topology as JSON string
  modelWeights  Bytes                      // Binary weights (varbinary(max) in MSSQL)

  // Training metadata
  accuracy      Decimal? @db.Decimal(5, 4)  // Model accuracy (0.0000-1.0000)
  loss          Decimal? @db.Decimal(10, 6) // Final training loss
  tradesUsed    Int?     @db.Int            // Number of trades used for training
  epochsTrained Int?     @db.Int            // Number of training epochs
  trainingStats String?  @db.NVarChar(Max)  // JSON with detailed training stats

  // Privacy tracking
  uniqueUsers   Int?     @db.Int            // Number of unique users in training data
  tickersUsed   Int?     @db.Int            // Number of tickers in training data

  // Status
  trainedAt     DateTime @default(now()) @db.DateTime
  isActive      Boolean  @default(true) @db.Bit

  // Only one active model per type
  @@unique([modelType, isActive])
  @@index([modelType])
  @@map("communityMLModels")
}

// ============================================================================
// ML/DL FOR ALL OPTIONS TRADING
// ============================================================================

// OptionsMLModel - Stores trained models for general options predictions
// Extends beyond wheel strategy to all options strategies
model OptionsMLModel {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  userId        String   @db.UniqueIdentifier

  // Model identification
  modelType     String   @db.VarChar(50) // volatility-regime, entry-timing, exit-strategy, strategy-classifier, risk-analyzer, etc.
  modelName     String   @db.VarChar(100) // Human-readable name

  // Versioning
  version       Int      @default(1) @db.Int

  // Model artifacts - TensorFlow.js format
  modelTopology String   @db.NVarChar(Max) // model.json topology as JSON string
  modelWeights  Bytes                      // Binary weights (varbinary(max) in MSSQL)

  // Architecture metadata
  architecture  String?  @db.NVarChar(Max) // JSON describing layers, units, activations

  // Training metadata
  accuracy      Decimal? @db.Decimal(5, 4)  // Model accuracy (0.0000-1.0000)
  loss          Decimal? @db.Decimal(10, 6) // Final training loss
  valLoss       Decimal? @db.Decimal(10, 6) // Validation loss
  tradesUsed    Int?     @db.Int            // Number of trades used for training
  epochsTrained Int?     @db.Int            // Number of training epochs
  trainingStats String?  @db.NVarChar(Max)  // JSON with detailed training stats

  // Status
  trainedAt     DateTime @default(now()) @db.DateTime
  isActive      Boolean  @default(true) @db.Bit

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Only one active model per type per user
  @@unique([userId, modelType, isActive])
  @@index([userId])
  @@index([userId, modelType])
  @@map("optionsMLModels")
}

// FeatureStore - Pre-computed and cached ML features
// Reduces computation overhead and enables feature reuse across models
model FeatureStore {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  userId        String   @db.UniqueIdentifier

  // Feature identification
  symbol        String   @db.VarChar(20)
  featureType   String   @db.VarChar(50) // volatility, momentum, user_pattern, symbol_profile, etc.

  // Feature data
  features      String   @db.NVarChar(Max) // JSON serialized feature vector
  featureCount  Int      @db.Int           // Number of features in vector

  // Time window this feature represents
  windowStart   DateTime? @db.DateTime
  windowEnd     DateTime? @db.DateTime

  // Cache management
  computedAt    DateTime @default(now()) @db.DateTime
  expiresAt     DateTime @db.DateTime
  isValid       Boolean  @default(true) @db.Bit

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, featureType])
  @@index([userId, expiresAt])
  @@index([userId, symbol])
  @@index([userId, featureType])
  @@map("featureStore")
}

// TradeEmbedding - Vector embeddings for trade similarity search
// Enables "find similar trades" functionality
model TradeEmbedding {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  userId          String   @db.UniqueIdentifier
  realizedCloseId String?  @db.UniqueIdentifier // Link to source trade

  // Trade identification
  symbol          String   @db.VarChar(20)
  strategy        String   @db.VarChar(30)

  // Embedding vector (stored as JSON array of floats)
  embedding       String   @db.NVarChar(Max) // JSON array [0.123, -0.456, ...]
  embeddingDim    Int      @db.Int           // Dimensionality (e.g., 32, 64)

  // Trade outcome for similarity queries
  outcome         String   @db.VarChar(10)   // win, loss, breakeven
  pnlPercent      Decimal  @db.Decimal(10, 4)
  holdDays        Int      @db.Int

  // Feature snapshot used to create embedding
  features        String?  @db.NVarChar(Max) // Original features (for debugging)

  // Timestamps
  tradeDate       DateTime @db.DateTime
  createdAt       DateTime @default(now()) @db.DateTime

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, symbol])
  @@index([userId, strategy])
  @@index([userId, outcome])
  @@map("tradeEmbeddings")
}

// DailyInsight - Generated daily trading insights
// Personalized briefings and recommendations
model DailyInsight {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  userId          String   @db.UniqueIdentifier

  // Insight date
  insightDate     DateTime @db.Date

  // Summary metrics (JSON)
  summary         String   @db.NVarChar(Max) // { totalPositions, netDelta, dailyTheta, unrealizedPnL }

  // Action items (JSON array)
  actionItems     String   @db.NVarChar(Max) // [{ type, symbol, priority, description, recommendation }]

  // Opportunities (JSON array)
  opportunities   String   @db.NVarChar(Max) // [{ symbol, strategy, confidence, reasoning }]

  // Risk alerts (JSON array)
  riskAlerts      String   @db.NVarChar(Max) // [{ type, severity, description, action }]

  // Learning insights (JSON array of strings)
  learnings       String?  @db.NVarChar(Max) // ["Pattern: X", "Suggestion: Y"]

  // Generation metadata
  generatedAt     DateTime @default(now()) @db.DateTime
  modelVersion    String?  @db.VarChar(50)  // Which model version generated this

  // User interaction
  wasViewed       Boolean  @default(false) @db.Bit
  viewedAt        DateTime? @db.DateTime

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, insightDate])
  @@index([userId])
  @@index([userId, insightDate])
  @@map("dailyInsights")
}

// PositionHealthAlert - Real-time position monitoring alerts
// Generated when positions need attention
model PositionHealthAlert {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  userId          String   @db.UniqueIdentifier
  positionId      String?  @db.UniqueIdentifier // Link to DerivedPosition

  // Alert details
  alertType       String   @db.VarChar(50)  // THETA_DECAY, APPROACHING_EXPIRY, ADVERSE_MOVE, PROFIT_TARGET, etc.
  severity        String   @db.VarChar(20)  // info, warning, critical
  symbol          String   @db.VarChar(20)

  // Alert content
  title           String   @db.NVarChar(200)
  description     String   @db.NVarChar(Max)
  recommendation  String?  @db.NVarChar(Max)

  // Context data (JSON)
  context         String?  @db.NVarChar(Max) // { currentPrice, strike, daysToExpiry, pnl, etc. }

  // Status
  createdAt       DateTime @default(now()) @db.DateTime
  expiresAt       DateTime? @db.DateTime     // Alert no longer relevant after this
  isDismissed     Boolean  @default(false) @db.Bit
  dismissedAt     DateTime? @db.DateTime
  isActioned      Boolean  @default(false) @db.Bit // User took recommended action
  actionedAt      DateTime? @db.DateTime

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, alertType])
  @@index([userId, isDismissed])
  @@index([userId, createdAt])
  @@map("positionHealthAlerts")
}

// MLPredictionLog - Stores all ML predictions for accuracy tracking
// Unified prediction tracking across all model types
model MLPredictionLog {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  userId          String   @db.UniqueIdentifier

  // Model that made prediction
  modelType       String   @db.VarChar(50)  // volatility-regime, entry-timing, etc.
  modelVersion    Int      @db.Int

  // Prediction details
  symbol          String?  @db.VarChar(20)
  predictionType  String   @db.VarChar(30)  // regime, score, recommendation, etc.
  prediction      String   @db.NVarChar(Max) // JSON serialized prediction
  confidence      Decimal? @db.Decimal(5, 4) // 0.0000-1.0000
  uncertainty     Decimal? @db.Decimal(5, 4) // For ensemble models

  // Outcome tracking
  actualOutcome   String?  @db.NVarChar(Max) // JSON of what happened
  wasAccurate     Boolean? @db.Bit
  errorMagnitude  Decimal? @db.Decimal(10, 4) // For regression: |predicted - actual|

  // Timestamps
  createdAt       DateTime @default(now()) @db.DateTime
  resolvedAt      DateTime? @db.DateTime

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, modelType])
  @@index([userId, wasAccurate])
  @@map("mlPredictionLogs")
}

// StrategySimulation - Stores strategy simulation results
// For the strategy simulator feature
model StrategySimulation {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  userId          String   @db.UniqueIdentifier

  // Simulation parameters
  symbol          String   @db.VarChar(20)
  strategy        String   @db.VarChar(30)  // long_call, covered_call, iron_condor, etc.
  strike          Decimal? @db.Decimal(18, 6)
  strike2         Decimal? @db.Decimal(18, 6) // For spreads
  dte             Int      @db.Int
  positionSize    Int      @db.Int           // Number of contracts

  // Simulation results (JSON)
  expectedOutcomes String  @db.NVarChar(Max) // [{ scenario, probability, pnl }]
  riskMetrics     String   @db.NVarChar(Max) // { maxLoss, breakeven, pop }
  historicalComp  String?  @db.NVarChar(Max) // { similarTrades, winRate, avgReturn }

  // Greeks at simulation time
  estimatedDelta  Decimal? @db.Decimal(10, 6)
  estimatedTheta  Decimal? @db.Decimal(10, 6)
  estimatedVega   Decimal? @db.Decimal(10, 6)

  // Timestamp
  createdAt       DateTime @default(now()) @db.DateTime

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, symbol])
  @@index([userId, strategy])
  @@map("strategySimulations")
}

// ============================================================================
// TRADE CLASSIFICATION (Calendar feature)
// ============================================================================

// TradeClassification - User overrides for trade type (daytrade/swingtrade)
// Keyed by immutable composite fields so overrides survive re-derivation
model TradeClassification {
  id         String    @id @default(uuid()) @db.UniqueIdentifier
  userId     String    @db.UniqueIdentifier
  symbol     String    @db.VarChar(20)
  openDate   DateTime  @db.DateTime
  closeDate  DateTime  @db.DateTime
  closeType  String    @db.VarChar(10)
  optionType String?   @db.VarChar(4)
  strike     Decimal?  @db.Decimal(18, 6)
  expiration DateTime? @db.Date
  tradeType  String    @db.VarChar(20) // daytrade, swingtrade
  createdAt  DateTime  @default(now()) @db.DateTime
  updatedAt  DateTime  @updatedAt @db.DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, openDate, closeDate, closeType, optionType, strike, expiration])
  @@index([userId])
  @@map("tradeClassifications")
}

// ============================================================================
// AVIN AI CHAT
// ============================================================================

// Conversation - A chat thread between a user and Avin
model Conversation {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  userId     String   @db.UniqueIdentifier
  title      String   @db.NVarChar(200)
  isArchived Boolean  @default(false) @db.Bit
  createdAt  DateTime @default(now()) @db.DateTime
  updatedAt  DateTime @updatedAt @db.DateTime

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([userId, isArchived])
  @@map("conversations")
}

// ChatMessage - Individual message in a conversation
model ChatMessage {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  conversationId String   @db.UniqueIdentifier
  role           String   @db.VarChar(20) // 'user' | 'assistant' | 'tool'
  content        String   @db.NVarChar(Max)
  toolCallId     String?  @db.VarChar(100)
  toolName       String?  @db.VarChar(50)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  createdAt      DateTime @default(now()) @db.DateTime

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chatMessages")
}

// ============================================================================
// TSLA THESIS — AI-updated market data for the public thesis page
