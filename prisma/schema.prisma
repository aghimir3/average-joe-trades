// DailyJournal - Pre/post market journal entries with trading reflections
model DailyJournal {
  id     String   @id @default(uuid()) @db.UniqueIdentifier
  userId String   @db.UniqueIdentifier
  date   DateTime @db.Date // Journal date (one per day)

  // Pre-market preparation
  preMarketNotes   String? @db.NVarChar(4000) // Market outlook, plan for the day
  preMarketMood    String? @db.VarChar(20) // confident, neutral, cautious, anxious
  watchlist        String? @db.NVarChar(1000) // Tickers watching today (comma-separated or JSON)
  keyLevels        String? @db.NVarChar(1000) // Support/resistance levels to watch

  // Health & wellness (affects trading performance)
  hoursSlept       Decimal? @db.Decimal(3, 1) // e.g., 7.5 hours
  sleepQuality     String?  @db.VarChar(20) // excellent, good, fair, poor
  exercised        Boolean? @db.Bit
  caffeineIntake   String?  @db.VarChar(20) // none, light, moderate, heavy
