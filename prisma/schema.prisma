// ============================================================================
// PORTFOLIO POLICY
// ============================================================================

// PortfolioPolicy - Trading rules, risk management, and investment policy per brokerage account
model PortfolioPolicy {
  id                 String  @id @default(uuid()) @db.UniqueIdentifier
  userId             String  @db.UniqueIdentifier
  brokerageAccountId String? @unique @db.UniqueIdentifier // NULL = default policy for all accounts

  // =========== TRADING RULES ===========
  // Position sizing
  maxPositionSizePercent   Decimal? @db.Decimal(5, 2) // Max % of portfolio per position
  maxPositionSizeDollars   Decimal? @db.Decimal(18, 2) // Max $ per position
  defaultPositionSize      Decimal? @db.Decimal(18, 2) // Default position size

  // Entry/Exit criteria
  entryRules               String?  @db.NVarChar(4000) // User's entry criteria
  exitRules                String?  @db.NVarChar(4000) // User's exit criteria

  // Trade management
  maxOpenPositions         Int?     @db.Int // Max concurrent positions
  maxDailyTrades           Int?     @db.Int // Max trades per day
  maxDailyLoss             Decimal? @db.Decimal(18, 2) // Daily loss limit to stop trading

  // Trading schedule
  tradingHoursStart        String?  @db.VarChar(5) // HH:MM format (e.g., "09:30")
  tradingHoursEnd          String?  @db.VarChar(5) // HH:MM format (e.g., "16:00")
  tradingDays              String?  @db.VarChar(20) // Comma-separated days (e.g., "mon,tue,wed,thu,fri")

  // =========== RISK MANAGEMENT ===========
  // Stop-loss rules
  defaultStopLossPercent   Decimal? @db.Decimal(5, 2) // Default stop-loss %
  maxStopLossPercent       Decimal? @db.Decimal(5, 2) // Never risk more than this %
  useTrailingStops         Boolean? @db.Bit
  trailingStopPercent      Decimal? @db.Decimal(5, 2)

  // Drawdown limits
  maxDrawdownPercent       Decimal? @db.Decimal(5, 2) // Max portfolio drawdown
  maxWeeklyLossPercent     Decimal? @db.Decimal(5, 2) // Weekly loss limit
  maxMonthlyLossPercent    Decimal? @db.Decimal(5, 2) // Monthly loss limit

  // Sector/concentration limits
  maxSectorExposurePercent Decimal? @db.Decimal(5, 2) // Max exposure to any sector
  maxSingleStockPercent    Decimal? @db.Decimal(5, 2) // Max single stock exposure

  // Options-specific risk
  maxOptionsPercent        Decimal? @db.Decimal(5, 2) // Max portfolio % in options
  maxNakedPutsPercent      Decimal? @db.Decimal(5, 2) // Max % in cash-secured puts
  maxCoveredCallsPercent   Decimal? @db.Decimal(5, 2) // Max % in covered calls
  minDaysToExpiration      Int?     @db.Int // Minimum DTE for new options

  // =========== INVESTMENT POLICY ===========
  // Asset allocation targets
  targetStockPercent       Decimal? @db.Decimal(5, 2)
  targetOptionsPercent     Decimal? @db.Decimal(5, 2)
  targetCashPercent        Decimal? @db.Decimal(5, 2)

  // Rebalancing
  rebalanceFrequency       String?  @db.VarChar(20) // weekly, monthly, quarterly, annually
  rebalanceThreshold       Decimal? @db.Decimal(5, 2) // Rebalance if off target by this %

  // Investment style
  investmentTimeHorizon    String?  @db.VarChar(20) // day, swing, position, long-term
  riskTolerance            String?  @db.VarChar(20) // conservative, moderate, aggressive

  // Diversification rules
  minPositions             Int?     @db.Int // Minimum positions for diversification
  maxCorrelatedPositions   Int?     @db.Int // Max positions in correlated assets

  // =========== PERSONAL NOTES & RULES ===========
  personalTradingRules     String?  @db.NVarChar(Max) // Free-form trading rules/reminders
  preTradeChecklist        String?  @db.NVarChar(Max) // Checklist before entering trades
  emotionalRules           String?  @db.NVarChar(Max) // Rules for managing emotions
  marketConditionRules     String?  @db.NVarChar(Max) // Rules for different market conditions

  // Timestamps
  createdAt DateTime @default(now()) @db.DateTime
  updatedAt DateTime @updatedAt @db.DateTime

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerageAccount BrokerageAccount? @relation(fields: [brokerageAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // One policy per account (or one default policy with null brokerageAccountId)
  @@unique([userId, brokerageAccountId])
  @@index([userId])
  @@index([brokerageAccountId])
  @@map("portfolioPolicies")
}

// ============================================================================
// API REQUEST LOGGING
// ============================================================================

// ApiRequestLog - Logs all external API requests and responses for debugging
// Used for SnapTrade, Plaid, and other external service integrations
model ApiRequestLog {
  id     String @id @default(uuid()) @db.UniqueIdentifier
  userId String @db.UniqueIdentifier

  // Request identification
  service     String @db.VarChar(50) // 'snaptrade', 'plaid', etc.
  endpoint    String @db.VarChar(255) // API endpoint called
  method      String @db.VarChar(10) // GET, POST, PUT, DELETE

  // Request details
  requestParams  String? @db.NVarChar(Max) // JSON of request parameters (sanitized)
  requestHeaders String? @db.NVarChar(Max) // JSON of request headers (sanitized, no auth)

  // Response details
  statusCode     Int?     @db.Int
  responseBody   String?  @db.NVarChar(Max) // JSON response (may be truncated)
  responseSize   Int?     @db.Int // Size in bytes

  // Timing
  durationMs     Int?     @db.Int // Request duration in milliseconds

  // Error tracking
  isError        Boolean  @default(false) @db.Bit
  errorMessage   String?  @db.NVarChar(1000)
  errorCode      String?  @db.VarChar(50)

  // Context
  correlationId  String?  @db.VarChar(64) // Link to related requests
  triggeredBy    String?  @db.VarChar(100) // What triggered this call (e.g., "sync_transactions")

  // Timestamps
  createdAt DateTime @default(now()) @db.DateTime

  // Indexes for querying
  @@index([userId, createdAt])
  @@index([userId, service])
  @@index([service, endpoint])
  @@index([correlationId])
  @@index([isError])
  @@map("apiRequestLogs")
}

// ============================================================================
// SYNC ACTIVITY LOG - User-facing sync workflow tracking
// ============================================================================

model SyncActivityLog {
  id     String @id @default(uuid()) @db.UniqueIdentifier
  userId String @db.UniqueIdentifier

  // Event identification
  eventType String @db.VarChar(50) // 'connection_initiated', 'oauth_completed', 'accounts_discovered', etc.
  broker    String @db.VarChar(50) // 'robinhood', 'schwab', etc.

  // Account context (optional - not all events have an account)
  brokerageAccountId String? @db.UniqueIdentifier
  accountName        String? @db.VarChar(255)

  // Event details
  message     String  @db.NVarChar(500)  // Human-readable message
  details     String? @db.NVarChar(Max)  // JSON with additional context
  isError     Boolean @default(false) @db.Bit
  errorCode   String? @db.VarChar(50)

  // Correlation for linking related events
  correlationId String? @db.VarChar(64)

  // Timestamps
  createdAt DateTime @default(now()) @db.DateTime

  // Relations (NoAction to avoid cyclic referential actions via User -> BrokerageAccount -> SyncActivityLog)
  user             User              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brokerageAccount BrokerageAccount? @relation(fields: [brokerageAccountId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([userId, eventType])
  @@index([userId, broker])
  @@index([brokerageAccountId])
  @@index([correlationId])
  @@index([isError])
  @@map("syncActivityLogs")
}

