// ============================================================================
// BROKER-PROVIDED DATA (Cached from SnapTrade/APIs)
// ============================================================================

// BrokerPosition - Cached position data from SnapTrade API
// Refreshed on-demand or periodically, NOT the source of truth for transactions
// Use this for real-time position view; use DerivedPosition for manual accounts
model BrokerPosition {
  id                 String @id @default(uuid()) @db.UniqueIdentifier
  userId             String @db.UniqueIdentifier
  brokerageAccountId String @db.UniqueIdentifier

  // Position identification
  symbol       String @db.VarChar(50)
  positionType String @db.VarChar(10) // stock, option

  // Option details (null for stocks)
  optionType String?   @db.VarChar(4) // call, put
  strike     Decimal?  @db.Decimal(18, 6)
  expiration DateTime? @db.Date

  // Position data from brokerage
  quantity         Decimal  @db.Decimal(18, 6)
  marketPrice      Decimal? @db.Decimal(18, 6) // Current market price per share/contract
  marketValue      Decimal? @db.Decimal(18, 6) // quantity * price (total value)
  avgCostBasis     Decimal? @db.Decimal(18, 6) // Brokerage-provided cost basis per share
  unrealizedPnL    Decimal? @db.Decimal(18, 6) // Brokerage-provided open P&L
  unrealizedPnLPct Decimal? @db.Decimal(10, 4) // Unrealized P&L %

  // Price change tracking (since last sync)
  previousPrice  Decimal? @db.Decimal(18, 6) // Price at previous sync
  priceChangeAbs Decimal? @db.Decimal(18, 6) // Current - Previous price
  priceChangePct Decimal? @db.Decimal(10, 4) // % change since last sync

  // Currency
  currency String @default("USD") @db.VarChar(10)

  // Data source tracking
  snaptradeSyncId String? @db.VarChar(64) // Correlation ID for sync
  dataSource      String  @db.VarChar(20) // 'snaptrade'

  // Freshness tracking
  lastSyncAt DateTime @db.DateTime
  isStale    Boolean  @default(false) @db.Bit

  // Timestamps
  createdAt DateTime @default(now()) @db.DateTime
  updatedAt DateTime @updatedAt @db.DateTime

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerageAccount BrokerageAccount @relation(fields: [brokerageAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Unique per instrument per account
  @@unique([brokerageAccountId, symbol, positionType, optionType, strike, expiration])
  @@index([userId])
  @@index([brokerageAccountId])
  @@index([lastSyncAt])
  @@index([userId, isStale])
  @@map("brokerPositions")
}

// BrokerBalance - Cached account balance data from SnapTrade API
// Each account may have multiple balances (one per currency)
model BrokerBalance {
  id                 String @id @default(uuid()) @db.UniqueIdentifier
  userId             String @db.UniqueIdentifier
  brokerageAccountId String @db.UniqueIdentifier

  // Balance data
  currency    String   @db.VarChar(10)
  cash        Decimal? @db.Decimal(18, 6)
  buyingPower Decimal? @db.Decimal(18, 6) // May be null for non-margin accounts

  // Freshness
  lastSyncAt DateTime @db.DateTime

  // Timestamps
  createdAt DateTime @default(now()) @db.DateTime
  updatedAt DateTime @updatedAt @db.DateTime

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerageAccount BrokerageAccount @relation(fields: [brokerageAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // One balance per currency per account
  @@unique([brokerageAccountId, currency])
  @@index([userId])
  @@index([brokerageAccountId])
  @@map("brokerBalances")
}

// BrokerReturnRate - Cached performance data from brokerage
// Stores return percentages for various timeframes (ALL, 1Y, 6M, 3M, 1M)
model BrokerReturnRate {
  id                 String @id @default(uuid()) @db.UniqueIdentifier
  userId             String @db.UniqueIdentifier
  brokerageAccountId String @db.UniqueIdentifier

  // Performance data
  timeframe     String  @db.VarChar(10) // ALL, 1Y, 6M, 3M, 1M
  returnPercent Decimal @db.Decimal(10, 4) // e.g., 5.97 = 5.97%

