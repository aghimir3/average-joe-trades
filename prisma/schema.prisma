model TslaThesisData {
  id        String   @id @default("singleton") @db.VarChar(20)
  data      String   @db.NVarChar(Max) // JSON blob with market data
  updatedAt DateTime @default(now()) @db.DateTime
  updatedBy String   @default("manual") @db.VarChar(50)

  @@map("tslaThesisData")
}
