  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerageAccount BrokerageAccount @relation(fields: [brokerageAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // One rate per timeframe per account
  @@unique([brokerageAccountId, timeframe])
  @@index([userId])
  @@index([brokerageAccountId])
  @@map("brokerReturnRates")
