// ============================================================================
// Average Joe Trades - Ledger-Only Multi-Account Schema (2026)
// Azure SQL Server / MSSQL Database
//
// Financial-grade schema for stock & options trading journal
// Architecture: Ledger-only source of truth, multi-brokerage account support
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// ============================================================================
// AUTHENTICATION & USERS
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime? @db.DateTime
  name          String?   @db.VarChar(255)
  image         String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.DateTime
  updatedAt     DateTime  @updatedAt @db.DateTime

  // Relations
  accounts              Account[]
  brokerageAccounts     BrokerageAccount[]
  importBatches         ImportBatch[]
  tags                  Tag[]
  // Ledger system relations
  ledgerEvents          LedgerEvent[]
  derivedPositions      DerivedPosition[]
  realizedCloses        RealizedClose[]
  dailyAggregates       DailyAggregate[]
  importIssues          ImportIssue[]
  tradingGoals          TradingGoal[]
  // Journal system relations
  dailyJournals         DailyJournal[]
  tradeNotes            TradeNote[]
  // Portfolio policies (one per brokerage account)
  portfolioPolicies     PortfolioPolicy[]
  // Service integrations (SnapTrade, etc.)
  serviceCredentials    ServiceCredential[]
  loginNicknames        LoginNickname[]
  // User preferences
  userSettings          UserSettings?
  // Broker-provided position/balance data (cached from APIs)
  brokerPositions       BrokerPosition[]
  brokerBalances        BrokerBalance[]
  brokerReturnRates     BrokerReturnRate[]
  // ML/DL models for wheel strategy
  wheelMLModels         WheelMLModel[]
  wheelPredictions      WheelPrediction[]
  wheelTrainingData     WheelTrainingData[]
  // ML/DL models for all options trading
  optionsMLModels       OptionsMLModel[]
  featureStore          FeatureStore[]
  tradeEmbeddings       TradeEmbedding[]
  dailyInsights         DailyInsight[]
  positionHealthAlerts  PositionHealthAlert[]
  mlPredictionLogs      MLPredictionLog[]
  strategySimulations   StrategySimulation[]
  // User activity tracking
  userSessions          UserSession[]
  pageViewEvents        PageViewEvent[]
  // AI Insights action lifecycle
  aiActionStates        AIActionState[]
  // Sentiment logging
  sentimentEntries      SentimentEntry[]
  // Quant/AI governance + research runs
  quantModelRegistry    QuantModelRegistry[]
  quantModelEvaluations QuantModelEvaluation[]
  quantBacktestRuns     QuantBacktestRun[]
  // Sync activity logs
  syncActivityLogs      SyncActivityLog[]
  // Trade type overrides (daytrade/swingtrade)
  tradeClassifications  TradeClassification[]
  // MCP API keys
  apiKeys               ApiKey[]
  // Avin AI chat
  conversations         Conversation[]
  @@index([email])
  @@map("users")
}

// ServiceCredential - External service credentials (SnapTrade, Plaid, etc.)
// Separate table for security isolation and multi-service support
model ServiceCredential {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  userId    String   @db.UniqueIdentifier
  service   String   @db.VarChar(50) // 'snaptrade', 'plaid', etc.

  // Service-specific credentials. Protect the database and backups for production deployments.
  serviceUserId     String  @db.VarChar(255) // External service's user ID
  serviceUserSecret String  @db.VarChar(500) // External service's user secret/token

  // Connection metadata
  isActive    Boolean   @default(true) @db.Bit
  lastSyncAt  DateTime? @db.DateTime
  syncStatus  String?   @db.VarChar(50) // 'success', 'error', 'pending'
  syncError   String?   @db.NVarChar(1000)

  // Timestamps
  createdAt DateTime @default(now()) @db.DateTime
  updatedAt DateTime @updatedAt @db.DateTime

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One credential per service per user
  @@unique([userId, service])
  @@index([userId])
  @@index([service])
  @@map("serviceCredentials")
}

// ApiKey - Personal API keys for MCP server access
// Keys are SHA-256 hashed; plaintext shown once at creation, never stored
model ApiKey {
  id         String    @id @default(uuid()) @db.UniqueIdentifier
  userId     String    @db.UniqueIdentifier
  name       String    @db.VarChar(100)
  keyHash    String    @unique @db.VarChar(64)
  keyPrefix  String    @db.VarChar(12)
  lastUsedAt DateTime? @db.DateTime
  expiresAt  DateTime? @db.DateTime
  isActive   Boolean   @default(true) @db.Bit
  createdAt  DateTime  @default(now()) @db.DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("apiKeys")
}

// LoginNickname - User-defined names for brokerage login connections
// Allows users to label multiple logins (e.g., "Mine", "Wife's")
model LoginNickname {
  id                       String @id @default(uuid()) @db.UniqueIdentifier
  userId                   String @db.UniqueIdentifier
  brokerageAuthorizationId String @db.VarChar(100) // SnapTrade authorization ID
  nickname                 String @db.NVarChar(50) // User-defined label

  // Timestamps
  createdAt DateTime @default(now()) @db.DateTime
  updatedAt DateTime @updatedAt @db.DateTime

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One nickname per authorization per user
  @@unique([userId, brokerageAuthorizationId])
  @@index([userId])
  @@map("loginNicknames")
}

// UserSettings - User preferences (auto-sync, theme, screen lock, etc.)
// One settings record per user
model UserSettings {
  id     String @id @default(uuid()) @db.UniqueIdentifier
  userId String @unique @db.UniqueIdentifier

  // Sync preferences
  autoSyncEnabled Boolean @default(false) @db.Bit // Daily auto-sync on dashboard load

  // Onboarding
  dashboardTourSeen Boolean @default(false) @db.Bit // Guided tour completed or skipped

  // Screen Lock Settings
  screenLockEnabled  Boolean @default(false) @db.Bit // Whether screen lock is enabled
  screenLockTimeout  Int     @default(300) @db.Int   // Timeout in seconds (default: 5 minutes)
  screenLockPinHash  String? @db.VarChar(255)        // Argon2id hashed PIN (fallback auth)

  // Timestamps
  createdAt DateTime @default(now()) @db.DateTime
  updatedAt DateTime @updatedAt @db.DateTime

  // Relations
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  webauthnCredentials WebAuthnCredential[]

  @@index([userId])
  @@map("userSettings")
}

// WebAuthnCredential - Passkey/biometric credentials for screen lock
// Stores the public key and metadata for WebAuthn authentication
model WebAuthnCredential {
  id             String @id @default(uuid()) @db.UniqueIdentifier
  userSettingsId String @db.UniqueIdentifier

  // Credential identification
  credentialId     String @unique @db.VarChar(512) // Base64URL encoded credential ID
  publicKey        String @db.VarChar(2000)        // Base64URL encoded public key
  counter          Int    @default(0) @db.Int      // Sign counter for replay protection

  // Credential metadata
  deviceName       String?   @db.VarChar(100)      // User-friendly name (e.g., "iPhone 15 Pro")
  transports       String?   @db.VarChar(100)      // JSON array of transports (e.g., ["internal", "hybrid"])
  credentialType   String    @default("public-key") @db.VarChar(20)
  attestationType  String?   @db.VarChar(20)       // none, indirect, direct, enterprise

  // Security tracking
  lastUsedAt       DateTime? @db.DateTime
  createdAt        DateTime  @default(now()) @db.DateTime

  // Relations
  userSettings UserSettings @relation(fields: [userSettingsId], references: [id], onDelete: Cascade)

  @@index([userSettingsId])
  @@index([credentialId])
  @@map("webauthnCredentials")
}

// Account - NextAuth OAuth provider accounts (Google, etc.)
// Note: Named "Account" for NextAuth PrismaAdapter compatibility
model Account {
  id                String  @id @default(uuid()) @db.UniqueIdentifier
  userId            String  @db.UniqueIdentifier
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(50)
  providerAccountId String  @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?    @db.Int
  token_type        String? @db.VarChar(50)
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts") // Keep table name for NextAuth compatibility
}

model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime @db.DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// BROKERAGE ACCOUNTS (Multi-Account Support)
// ============================================================================

// BrokerageAccount - User's trading accounts at various brokerages
// Examples: "Robinhood Individual", "Schwab IRA", "Fidelity 401k"
// A default "Individual" account with broker="manual" is auto-created for new users
model BrokerageAccount {
  id     String @id @default(uuid()) @db.UniqueIdentifier
  userId String @db.UniqueIdentifier

  // Account identification
  broker            String  @db.VarChar(50) // 'manual' | 'robinhood' | 'schwab' | 'fidelity' | etc.
  name              String  @db.VarChar(100) // Display name: "Individual", "Robinhood", "Schwab IRA"
  externalAccountId String? @db.VarChar(255) // Broker's account ID if available

  // SnapTrade OAuth connection tracking
  // Groups accounts from the same OAuth connection (e.g., user's Robinhood vs spouse's Robinhood)
  // Multiple BrokerageAccounts can share the same brokerageAuthorizationId
  // (e.g., Individual + Roth IRA from one person's Robinhood auth)
  brokerageAuthorizationId String? @db.VarChar(255)

  // Settings
  currency  String  @default("USD") @db.VarChar(10)
  isDefault Boolean @default(false) @db.Bit // First account is default
  isActive  Boolean @default(true) @db.Bit // Can be deactivated without deletion

  // Timestamps
  createdAt DateTime @default(now()) @db.DateTime
  updatedAt DateTime @updatedAt @db.DateTime

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEvents     LedgerEvent[]
  importBatches    ImportBatch[]
  derivedPositions DerivedPosition[]
  realizedCloses   RealizedClose[]
  dailyAggregates  DailyAggregate[]
  portfolioPolicy  PortfolioPolicy?
  // Broker-provided data (cached from APIs)
  brokerPositions   BrokerPosition[]
  brokerBalances    BrokerBalance[]
  brokerReturnRates BrokerReturnRate[]
  tradingGoals      TradingGoal[]
  // Sync activity logs
  syncActivityLogs  SyncActivityLog[]

  // Note: Multiple accounts per broker are allowed (e.g., multiple Robinhood accounts)
  // When syncing with external services, each external account maps to one BrokerageAccount
  // The unique constraint is enforced at the application level for non-null externalAccountId
  // Indexes
  @@index([userId])
  @@index([userId, isDefault])
  @@index([userId, broker])
  @@index([userId, externalAccountId])
  @@index([userId, brokerageAuthorizationId])
  @@map("brokerageAccounts")
}

// ============================================================================
// IMPORT SYSTEM
// ============================================================================

model ImportBatch {
  id                 String @id @default(uuid()) @db.UniqueIdentifier
  userId             String @db.UniqueIdentifier
  brokerageAccountId String @db.UniqueIdentifier // Which account this import belongs to

  // Source identification
  fileName   String @db.VarChar(255)
  broker     String @db.VarChar(50) // 'robinhood' | 'schwab' | 'fidelity' | etc.
  sourceType String @default("import") @db.VarChar(20) // 'import' | 'manual' | 'api'

  // Processing Status
  status String @default("pending") @db.VarChar(20) // 'pending' | 'processing' | 'completed' | 'failed'

  // Import Metrics
  totalRows      Int @default(0) @db.Int
  parsedRows     Int @default(0) @db.Int
  validatedRows  Int @default(0) @db.Int
  duplicateRows  Int @default(0) @db.Int
  importedEvents Int @default(0) @db.Int // Renamed from importedTrades
  skippedRows    Int @default(0) @db.Int

  // Detailed Tracking
  skipReasons  String? @db.Text // JSON: [{row, reason, symbol}]
  warnings     String? @db.Text // JSON: [{row, message, symbol}]
  errorMessage String? @db.Text

  // Date Range
  tradeStartDate DateTime? @db.DateTime
  tradeEndDate   DateTime? @db.DateTime

  // Archiving
  isArchived Boolean   @default(false) @db.Bit
  archivedAt DateTime? @db.DateTime
  archivedBy String?   @db.UniqueIdentifier

  // Timestamps
  createdAt   DateTime  @default(now()) @db.DateTime
  startedAt   DateTime? @db.DateTime
  completedAt DateTime? @db.DateTime

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerageAccount BrokerageAccount @relation(fields: [brokerageAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ledgerEvents     LedgerEvent[]

  @@index([userId, createdAt])
  @@index([userId, isArchived])
  @@index([userId, sourceType])
  @@index([brokerageAccountId])
  @@index([status])
  @@map("importBatches")
}

// ============================================================================
// LEDGER SYSTEM (Source of Truth)
// ============================================================================

// LedgerEvent - Immutable record of every transaction (manual + imports)
// This is the SINGLE SOURCE OF TRUTH for all trading activity.
// - Every transaction becomes one LedgerEvent
// - Append-only (never modified, only soft-deleted for corrections)
// - eventHash ensures idempotency
// - Positions and P&L are DERIVED from this ledger
model LedgerEvent {
  id                 String  @id @default(uuid()) @db.UniqueIdentifier
  userId             String  @db.UniqueIdentifier
  brokerageAccountId String  @db.UniqueIdentifier
  importBatchId      String? @db.UniqueIdentifier // Nullable for manual entries

  // Source tracking
  broker              String  @db.VarChar(50) // 'manual' | 'robinhood' | 'schwab' | etc.
  sourceType          String  @db.VarChar(20) // 'manual' | 'import' | 'api'
  sourceTransactionId String? @db.VarChar(255) // Broker-provided transaction ID if available

  // =========== Core Transaction Fields ===========
  activityDate DateTime  @db.DateTime // Normalized to UTC noon
  activityTime String?   @db.VarChar(5) // Optional time of day (HH:MM format, e.g., "09:30")
  processDate  DateTime? @db.DateTime
  settleDate   DateTime? @db.DateTime
  instrument   String    @db.VarChar(255) // Raw instrument description
  description  String?   @db.NVarChar(1000) // Full description
  transCode    String    @db.VarChar(20) // BUY, SELL, BTO, STO, BTC, STC, OEXP, OASGN, etc.
  quantity     Decimal   @db.Decimal(18, 6)
  price        Decimal?  @db.Decimal(18, 6)
  amount       Decimal?  @db.Decimal(18, 6)
  fees         Decimal?  @db.Decimal(10, 4) // Transaction fees if tracked

  // =========== Normalized/Parsed Fields ===========
  symbol     String    @db.VarChar(20) // Normalized ticker symbol
  eventType  String    @db.VarChar(30) // EQUITY_STOCK, EQUITY_OPTION, CASH_MOVEMENT, etc.
  action     String?   @db.VarChar(20) // buy, sell, expired, assigned, dividend, etc.
  isOption   Boolean   @default(false) @db.Bit
  optionType String?   @db.VarChar(4) // call, put
  strike     Decimal?  @db.Decimal(18, 6)
  expiration DateTime? @db.Date

  // =========== Strategy & Grouping (for manual entries) ===========
  strategy        String? @db.VarChar(50) // User-specified strategy
  positionGroupId String? @db.VarChar(64) // Groups related legs of a spread
  notes           String? @db.NVarChar(1000) // User notes for manual entries

  // =========== Underlying Price (for options) ===========
  // The price of the underlying stock at the time of this option transaction.
  // Useful for analyzing option trades relative to underlying movement.
  underlyingPrice Decimal? @db.Decimal(18, 6)

  // =========== Idempotency ===========
  // Hash of (userId, brokerageAccountId, activityDate, symbol, instrumentKey, transCode, qty, price, amount, sourceTransactionId)
  eventHash String @unique @db.VarChar(64)

  // =========== Audit Trail ===========
  createdAt DateTime  @default(now()) @db.DateTime
  deletedAt DateTime? @db.DateTime // Soft delete for corrections

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerageAccount BrokerageAccount @relation(fields: [brokerageAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  importBatch      ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Derivation links
  positionOpenEvents  PositionLedgerLink[] @relation("OpenEvent")
  positionCloseEvents PositionLedgerLink[] @relation("CloseEvent")

  // Indexes
  @@index([userId, activityDate])
  @@index([userId, brokerageAccountId, activityDate])
  @@index([userId, symbol, activityDate])
  @@index([userId, eventType])
  @@index([userId, deletedAt])
  @@index([userId, isOption])
  @@index([brokerageAccountId, symbol, activityDate])
  @@index([brokerageAccountId, isOption])
  @@index([brokerageAccountId, transCode])
  @@index([importBatchId])
  @@index([symbol, isOption, strike, expiration])
  @@index([positionGroupId])
  @@map("ledgerEvents")
}

// ============================================================================
// DERIVED DATA (Computed from Ledger)
// ============================================================================

// DerivedPosition - Computed open positions from ledger events
// Re-derived whenever ledger changes. NOT the source of truth.
model DerivedPosition {
  id                 String @id @default(uuid()) @db.UniqueIdentifier
  userId             String @db.UniqueIdentifier
  brokerageAccountId String @db.UniqueIdentifier

  // Position identification (instrument key)
  symbol       String @db.VarChar(20)
  positionType String @db.VarChar(10) // stock, option
  side         String @db.VarChar(10) // long, short

  // Option details (null for stocks)
  optionType String?   @db.VarChar(4) // call, put
  strike     Decimal?  @db.Decimal(18, 6)
  expiration DateTime? @db.Date

  // Position data
  quantity  Decimal @db.Decimal(18, 6) // Remaining open quantity
  costBasis Decimal @db.Decimal(18, 6) // Total cost basis
  avgPrice  Decimal @db.Decimal(18, 6) // Average entry price

  // Dates
  firstEntryDate DateTime @db.DateTime
  lastEntryDate  DateTime @db.DateTime

  // Strategy (from manual entries or detected)
  strategy String? @db.VarChar(50)

  // Derivation metadata
  derivedAt         DateTime @default(now()) @db.DateTime
  derivationVersion Int      @default(1) @db.Int

  // Relations
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerageAccount BrokerageAccount     @relation(fields: [brokerageAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ledgerLinks      PositionLedgerLink[]

  // Unique per instrument per account
  @@unique([userId, brokerageAccountId, symbol, positionType, side, optionType, strike, expiration])
  @@index([userId])
  @@index([userId, brokerageAccountId])
  @@index([userId, symbol])
  @@index([brokerageAccountId])
  @@map("derivedPositions")
}

// RealizedClose - Computed closed trades with P&L
// Each row = one matched open-close sequence (FIFO)
model RealizedClose {
  id                 String @id @default(uuid()) @db.UniqueIdentifier
  userId             String @db.UniqueIdentifier
  brokerageAccountId String @db.UniqueIdentifier

  // Instrument identification
  symbol    String @db.VarChar(20)
  closeType String @db.VarChar(10) // stock, option
  side      String @db.VarChar(10) // long, short

  // Option details (null for stocks)
  optionType String?   @db.VarChar(4) // call, put
  strike     Decimal?  @db.Decimal(18, 6)
  expiration DateTime? @db.Date
  strategy   String?   @db.VarChar(50)

  // Trade lifecycle
  openDate  DateTime @db.DateTime
  openTime  String?  @db.VarChar(5) // HH:MM format (e.g., "09:30", "14:45")
  closeDate DateTime @db.DateTime
  closeTime String?  @db.VarChar(5) // HH:MM format (e.g., "09:30", "14:45")
  quantity  Decimal  @db.Decimal(18, 6)

  // Pricing
  openPrice   Decimal @db.Decimal(18, 6)
  closePrice  Decimal @db.Decimal(18, 6)
  openAmount  Decimal @db.Decimal(18, 6)
  closeAmount Decimal @db.Decimal(18, 6)

  // P&L
  realizedPnL Decimal  @db.Decimal(18, 6)
  fees        Decimal? @db.Decimal(10, 4)

  // Close reason
  closeReason String @db.VarChar(20) // normal, expired, assigned

  // Underlying price tracking (for options)
  // Captured from source LedgerEvents during derivation
  underlyingPriceAtOpen  Decimal? @db.Decimal(18, 6)
  underlyingPriceAtClose Decimal? @db.Decimal(18, 6)

  // Assignment tracking
  isAssignment        Boolean  @default(false) @db.Bit
  assignedStockSymbol String?  @db.VarChar(20)
  assignedStockQty    Decimal? @db.Decimal(18, 6)
  assignedStockPrice  Decimal? @db.Decimal(18, 6)

  // Wheel tracking
  isWheelTrade Boolean @default(false) @db.Bit
  wheelCycleId String? @db.VarChar(64)

  // Unknown basis flag
  hasUnknownBasis Boolean @default(false) @db.Bit

  // Derivation metadata
  derivedAt         DateTime @default(now()) @db.DateTime
  derivationVersion Int      @default(1) @db.Int

  // Relations
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerageAccount BrokerageAccount     @relation(fields: [brokerageAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ledgerLinks      PositionLedgerLink[]

  // Indexes
  @@index([userId, closeDate])
  @@index([userId, brokerageAccountId, closeDate])
  @@index([userId, symbol])
  @@index([userId, strategy])
  @@index([userId, isWheelTrade])
  @@index([userId, hasUnknownBasis])
  @@index([brokerageAccountId])
  @@index([brokerageAccountId, closeDate])
  @@index([brokerageAccountId, hasUnknownBasis])
  @@map("realizedCloses")
}

// PositionLedgerLink - Audit trail linking positions/closes to source events
model PositionLedgerLink {
  id String @id @default(uuid()) @db.UniqueIdentifier

  // Link to derived entities (nullable - links to one or the other)
  positionId      String? @db.UniqueIdentifier
  realizedCloseId String? @db.UniqueIdentifier

  // Link to ledger events
  openEventId  String? @db.UniqueIdentifier
  closeEventId String? @db.UniqueIdentifier

  // Quantity attribution
  quantity Decimal @db.Decimal(18, 6)

  // Link type for audit
  linkType String @db.VarChar(20) // open, close, partial_open, partial_close

  createdAt DateTime @default(now()) @db.DateTime

  // Relations
  position      DerivedPosition? @relation(fields: [positionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  realizedClose RealizedClose?   @relation(fields: [realizedCloseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  openEvent     LedgerEvent?     @relation("OpenEvent", fields: [openEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  closeEvent    LedgerEvent?     @relation("CloseEvent", fields: [closeEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([positionId])
  @@index([realizedCloseId])
  @@index([openEventId])
  @@index([closeEventId])
  @@map("positionLedgerLinks")
}

// DailyAggregate - Pre-computed daily P&L (per account + optional all-accounts rollup)
model DailyAggregate {
  id                 String  @id @default(uuid()) @db.UniqueIdentifier
  userId             String  @db.UniqueIdentifier
  brokerageAccountId String? @db.UniqueIdentifier // NULL = all-accounts rollup

  // Date (normalized to UTC midnight)
  date DateTime @db.Date

  // Aggregates
  realizedPnL Decimal @db.Decimal(18, 6)
  tradeCount  Int     @db.Int
  winCount    Int     @db.Int
  lossCount   Int     @db.Int

  // Breakdown by type
  stockPnL      Decimal @db.Decimal(18, 6)
  optionPnL     Decimal @db.Decimal(18, 6)
  wheelPremiums Decimal @db.Decimal(18, 6)

  // Derivation metadata
  derivedAt DateTime @default(now()) @db.DateTime

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerageAccount BrokerageAccount? @relation(fields: [brokerageAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Unique per date per account (or all accounts if null)
  @@unique([userId, brokerageAccountId, date])
  @@index([userId, date])
  @@index([userId, brokerageAccountId, date])
  @@map("dailyAggregates")
}

// ============================================================================
// IMPORT ISSUES (Audit Trail)
// ============================================================================

model ImportIssue {
  id            String  @id @default(uuid()) @db.UniqueIdentifier
  userId        String  @db.UniqueIdentifier
  importBatchId String? @db.UniqueIdentifier

  // Issue classification
  issueType String @db.VarChar(50) // unknown_basis, parse_error, duplicate, etc.
  severity  String @db.VarChar(20) // error, warning, info

  // Related entities
  ledgerEventId   String? @db.UniqueIdentifier
  realizedCloseId String? @db.UniqueIdentifier

  // Details
  symbol  String? @db.VarChar(20)
  message String  @db.NVarChar(1000)
  details String? @db.NVarChar(Max) // JSON

  // Resolution tracking
  isResolved Boolean   @default(false) @db.Bit
  resolvedAt DateTime? @db.DateTime
  resolvedBy String?   @db.UniqueIdentifier
  resolution String?   @db.NVarChar(500)

  // Timestamps
  createdAt DateTime @default(now()) @db.DateTime

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isResolved])
  @@index([userId, issueType])
  @@index([importBatchId])
  @@index([ledgerEventId])
  @@map("importIssues")
}

